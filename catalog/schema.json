{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          },
          "type": {
            "enum": [
              "registry",
              "service",
              "scheduled_task",
              "appx",
              "startup",
              "power"
            ]
          },
          "category": {
            "enum": [
              "telemetry",
              "ai",
              "cortana",
              "xbox",
              "apps",
              "services",
              "ads",
              "gaming"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "risk": {
            "enum": [
              "none",
              "low",
              "high"
            ]
          },
          "riskNote": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pt-BR": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pt-BR",
              "en"
            ]
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pt-BR": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pt-BR",
              "en"
            ]
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pt-BR": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pt-BR",
              "en"
            ]
          },
          "minBuild": {
            "type": "integer",
            "minimum": 19045
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "registry"
                  },
                  "hive": {
                    "enum": [
                      "HKCU",
                      "HKLM"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "kind",
                  "hive",
                  "path",
                  "name",
                  "value"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "service"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "disabled",
                      "manual"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "mode"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "scheduled_task"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "name"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "appx"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "name"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "startup"
                  },
                  "hive": {
                    "enum": [
                      "HKCU",
                      "HKLM"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "hive"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "power"
                  },
                  "guid": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "guid"
                ]
              }
            ]
          },
          "revert": {
            "enum": [
              "auto",
              "manual"
            ]
          },
          "requiresReboot": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "verificationNote": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            },
            "uniqueItems": true
          },
          "supportedEditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "home",
                "pro",
                "enterprise",
                "education"
              ]
            },
            "uniqueItems": true
          },
          "requiresSsd": {
            "type": "boolean"
          },
          "maxBuild": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 19045
          }
        },
        "required": [
          "id",
          "type",
          "category",
          "level",
          "risk",
          "riskNote",
          "name",
          "description",
          "minBuild",
          "target",
          "revert",
          "requiresReboot",
          "verified",
          "verificationNote",
          "sources",
          "supportedEditions",
          "requiresSsd",
          "maxBuild"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "registry"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "registry"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "service"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "service"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "scheduled_task"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "scheduled_task"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "appx"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "appx"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "startup"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "startup"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "power"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "properties": {
                    "kind": {
                      "const": "power"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "items"
  ]
}
