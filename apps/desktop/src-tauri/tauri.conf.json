{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ametista",
  "version": "0.6.0",
  "identifier": "local.ametista.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ametista",
        "width": 1100,
        "height": 740,
        "minWidth": 360,
        "minHeight": 520,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Ametista"
  }
}
