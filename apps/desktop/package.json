{
  "name": "ametista-desktop",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview:test": "vite --mode test --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "format": "prettier --write src test e2e *.ts *.js *.json index.html",
    "format:check": "prettier --check src test e2e *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  }
}
